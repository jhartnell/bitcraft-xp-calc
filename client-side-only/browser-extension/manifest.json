{
  "manifest_version": 3,
  "name": "BitCraft Online XP Calculator",
  "version": "1.3.4",
  "description": "Real-time BitCraft Online crafting XP, ETA, and idle status alerts powered by BitJita API.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://bitjita.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "BitCraft XP Calculator",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "icons": {
    "128": "icon.png"
  }
}
